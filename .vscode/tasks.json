{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Parse and detect full Firex log",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.vscode\\run-parse-detection.ps1"
			],
			"isBackground": false,
			"problemMatcher": [],
			"group": "build"
		},
		{
			"label": "Benchmark parser thread counts (100 MiB sample)",
			"type": "process",
			"command": "powershell.exe",
			"args": [
				"-NoProfile",
				"-ExecutionPolicy",
				"Bypass",
				"-File",
				"${workspaceFolder}\\.vscode\\benchmark-parser-threads.ps1"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}